# ==============================================================
# SchoolSM Environment Configuration (.env & Render Environment)
# ==============================================================

# --------------------------------------------------------------
# 1. DATABASE CONNECTION (Neon.tech PostgreSQL Cloud Database)
# --------------------------------------------------------------
# យក Connection String ពី Neon.tech Dashboard (ប្រព័ន្ធគាំទ្រទាំង postgresql:// និង postgres://)
# ទិន្នន័យសិស្ស និងពិន្ទុទាំងអស់រស់នៅរហូតជាអចិន្ត្រៃយ៍លើ Cloud Database នេះ។
DATABASE_URL=postgresql://user:password@ep-sample-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------
# 2. CLOUDINARY MEDIA STORAGE (Persistent Photos & Documents)
# --------------------------------------------------------------
# រូបថតសិស្ស (៤x៦) និងឯកសារភ្ជាប់នឹងត្រូវរក្សាទុកលើ Cloudinary មិនបាត់បង់ពេល Render Rebuild ឡើយ។
# ជម្រើសទី ១ (ងាយស្រួលបំផុត)៖ ចម្លង CLOUDINARY_URL ទាំងមូលពី Cloudinary Dashboard
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ឬ ជម្រើសទី ២៖ បំបែកជា ៣ អថេរដាច់ដោយឡែក
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# --------------------------------------------------------------
# 3. GOOGLE SHEETS & GOOGLE DRIVE BACKUP (Service Account JSON)
# --------------------------------------------------------------
# បិទភ្ជាប់ខ្លឹមសារ JSON នៃ Google Service Account (១ បន្ទាត់ ឬ JSON string)
# ឬអាច Upload ឯកសារ google_service_account.json ក្នុងទំព័រ Tools -> Google Sheets Dashboard
GOOGLE_SERVICE_ACCOUNT_JSON=

# --------------------------------------------------------------
# 4. DJANGO CORE SECURITY
# --------------------------------------------------------------
SECRET_KEY=django-insecure-xeqsrma-9udx0s5m!-eojy9z6%xz=%4p(zy7mdbc*jvyo!1f34
DEBUG=True

# --------------------------------------------------------------
# 5. GOOGLE GEMINI AI AGENT
# --------------------------------------------------------------
# ទទួលយក API Key ឥតគិតថ្លៃនៅ: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
